<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares Pleya as a searchable app so the Assistant and the Android TV
  global-search row can send us an ACTION_SEARCH intent ("search X in Pleya").
  MainActivity.handleSearchIntent forwards the query to Dart; there is no
  content provider here on purpose — results are rendered in-app, not
  surfaced into the system search UI.
-->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:hint="@string/search_hint" />
