#!/usr/bin/env bash
set -uo pipefail

if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "[pre-push] skipped (SKIP_HOOKS=1)"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

# Alleen zinvol als er iets te ankeren valt. Bij een verse clone zonder
# docs/RELEASES.md laten we de push met rust.
[ -f "$ROOT/docs/RELEASES.md" ] || exit 0

# Deze hook schrijft niets meer en breekt niets meer af. Hij commit ook niet
# meer zelf: een pre-push hook draait nadat git de te pushen refs al heeft
# vastgesteld, dus zo'n commit ging toch niet mee en de push moest alsnog over.
# Dat kostte elke keer een ronde, en de commit belandde buiten de review van de
# PR waarin hij ontstond.
#
# De echte generatie hoort bij /update-docs en de releaseflow; die draait
# gen_release_notes.sh als eerste stap. Wat hier overblijft is de signalering.
if "$ROOT/scripts/gen_release_notes.sh" --check --quiet >/dev/null 2>&1; then
  exit 0
fi

cat >&2 <<'MSG'
[pre-push] docs/RELEASES.md loopt achter op de commits sinds de laatste build.

Dit blokkeert niets. Bijwerken doe je waar het hoort, in de documentatieronde:

  scripts/gen_release_notes.sh

MSG
exit 0
