# App Store Connect API key voor TestFlight uploads (fastlane).
# Aanmaken: App Store Connect → Users and Access → Integrations → App Store Connect API
# → nieuwe key met rol "App Manager". Kopieer dit bestand naar .env en vul in.
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# base64 van het gedownloade AuthKey_*.p8 bestand:  base64 -i AuthKey_ABC123DEFG.p8
ASC_KEY_CONTENT=

# Publieke sleutel die de release-lanes als --dart-define meegeven
# (ios_beta en macos_beta via fastlane, tvos_beta via tvos/scripts/xcode_appletv.sh).
# Leeg laten zet de functie in de app uit. Zie docs/release-baseline.md.
# Trakt: client-ID van een eigen app op https://trakt.tv/oauth/applications
# (Redirect URI: urn:ietf:wg:oauth:2.0:oob). Alleen het ID: het client secret
# gaat bewust niet in de app, want elke define is uit de binary te lezen.
TRAKT_CLIENT_ID=
