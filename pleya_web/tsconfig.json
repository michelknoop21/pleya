{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "sourceMap": true,
    "types": [
      "$app/types",
      "node",
      "bun",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "tests",
    "scripts/**/*.ts"
  ]
}
