# Pleya Server, PS-0. Kopieer naar .env en vul in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env valt onder de bestaande .gitignore-regel van de repo. Let wel op wat dat
# betekent: "docker inspect pleya-server" toont de environment van de container,
# dus wie Docker-toegang tot de NAS heeft kan dit wachtwoord lezen. Het bestand
# houdt de credential uit Git, niet uit het zicht van een Docker-beheerder.

# Genereer met: openssl rand -hex 32
# Bewust hex en geen base64: een DSN is een URL, en +, / en = vragen daar om
# escaping die vroeg of laat ergens misgaat.
POSTGRES_PASSWORD=vul-hier-de-uitvoer-van-openssl-rand-hex-32-in

# Hostpoort, gebonden aan 127.0.0.1 van de NAS. 8830 en 8831 zijn al bezet door
# de Pleya-website en de relay.
PLEYA_SERVER_HOST_PORT=8832

# De uid/gid waarmee de container draait. Op de DS920+ is dit 1026:100,
# dezelfde combinatie waarmee de Plex-container al leest.
PLEYA_UID=1000
PLEYA_GID=1000

# Drie schrijfbare hostmappen met drie verschillende levensduren.
#   config     duurzaam, dit is de back-up-eenheid
#   cache      herbouwbaar, hoort niet in een back-up
#   transcode  vluchtig, hoge churn
PLEYA_SERVER_CONFIG_HOST=./data/config
PLEYA_SERVER_CACHE_HOST=./data/cache
PLEYA_SERVER_TRANSCODE_HOST=./data/transcode

# De mediabibliotheek. Wordt read-only gemount.
PLEYA_SERVER_MEDIA_HOST=./testdata/media

PLEYA_SERVER_LOG_LEVEL=info
PLEYA_SERVER_VERSION=dev
TZ=Europe/Amsterdam
