# Pleya Server. Kopieer naar .env en vul in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env valt onder de bestaande .gitignore-regel van de repo. Let wel op wat dat
# betekent: "docker inspect pleya-server" toont de environment van de container,
# dus wie Docker-toegang tot de NAS heeft kan dit wachtwoord lezen. Het bestand
# houdt de credential uit Git, niet uit het zicht van een Docker-beheerder.

# Genereer met: openssl rand -hex 32
# Bewust hex en geen base64: een DSN is een URL, en +, / en = vragen daar om
# escaping die vroeg of laat ergens misgaat.
POSTGRES_PASSWORD=vul-hier-de-uitvoer-van-openssl-rand-hex-32-in

# Hostpoort, gebonden aan 127.0.0.1 van de NAS. 8830 en 8831 zijn al bezet door
# de Pleya-website en de relay.
PLEYA_SERVER_HOST_PORT=8832

# De uid/gid waarmee de container draait. Op de DS920+ is dit 1026:100,
# dezelfde combinatie waarmee de Plex-container al leest.
PLEYA_UID=1000
PLEYA_GID=1000

# Drie schrijfbare hostmappen met drie verschillende levensduren.
#   config     duurzaam, dit is de back-up-eenheid
#   cache      herbouwbaar, hoort niet in een back-up
#   transcode  vluchtig, hoge churn
PLEYA_SERVER_CONFIG_HOST=./data/config
PLEYA_SERVER_CACHE_HOST=./data/cache
PLEYA_SERVER_TRANSCODE_HOST=./data/transcode

# De mediabibliotheek. Wordt read-only gemount op /media/library.
PLEYA_SERVER_MEDIA_HOST=./testdata/media

# Een tweede volume op /media/library2, voor een bibliotheek die over twee
# bestandssystemen verspreid staat. Laat hem staan als u er maar een heeft: hij
# wijst dan naar dezelfde map en PLEYA_SERVER_LIBRARIES noemt hem niet.
PLEYA_SERVER_MEDIA_HOST_2=./testdata/media

# Bibliotheken: slug=soort:/pad[,/pad], gescheiden door puntkomma's. De soort is
# movies of shows. Een eigen titel kan tussen aanhalingstekens vóór de soort:
#   films="Onze films"=movies:/media/library/films
#
# De slug is de matchsleutel bij het opstarten. Verander hem niet zonder reden:
# een nieuwe slug is een nieuwe bibliotheek, met nieuwe ids.
PLEYA_SERVER_LIBRARIES=films=movies:/media/library

# Per root: mag de scanner op inodes bouwen (auto|always|never). Zonder
# vermelding beslist het bestandssysteemtype, en bij twijfel is dat never. Op
# fuseblk (ntfs-3g) staat dat op never tot een meting het tegendeel laat zien;
# de server logt die meting bij elke ronde als "inodemeting".
#PLEYA_SERVER_INODE_TRUST=/media/library/usb=never

# De naam die achter authenticatie in GET /pleya/v1/server staat. Hij staat
# bewust niet in het publieke /info.
PLEYA_SERVER_NAME=Pleya

# Scannen: bij het opstarten, en daarna elke zoveel tijd. 0 zet de periodieke
# ronde uit.
PLEYA_SERVER_SCAN_ON_START=true
PLEYA_SERVER_SCAN_INTERVAL=6h
PLEYA_SERVER_JOB_WORKERS=2

PLEYA_SERVER_LOG_LEVEL=info
PLEYA_SERVER_VERSION=dev
TZ=Europe/Amsterdam
