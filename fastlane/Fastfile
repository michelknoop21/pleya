# TestFlight-uploads voor iOS, tvOS en macOS (interne testers, geen Beta App Review).
# Credentials via .env in de project root (fastlane laadt die automatisch):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (base64 van de .p8)
# Aanroepen: `fastlane beta` (alles) of `fastlane ios_beta` / `tvos_beta` / `macos_beta`.

opt_out_usage

PROJECT_ROOT = File.expand_path("..", __dir__)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true,
  )
end

# Flutter shelt uit naar `pod`; fastlane's eigen GEM_HOME/GEM_PATH/RUBYOPT
# breken CocoaPods (Gem::MissingSpecError) — strip die voor flutter-calls.
def flutter_sh(cmd)
  sh("cd #{PROJECT_ROOT} && env -u GEM_HOME -u GEM_PATH -u RUBYOPT -u RUBYLIB -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH #{cmd}")
end

# Flutter genereert de umbrella-SPM-package (ios/Flutter/ephemeral/, gitignored)
# op iOS 13.0, maar background_downloader eist 14.0. Xcode resolvet Swift-packages
# vóór Flutter's eigen updateMinimumDeployment draait, dus forceer het manifest
# hier op de app-deploymenttarget — anders faalt build_app op
# "requires minimum platform version 14.0 ... but this target supports 13.0".
def patch_spm_min_ios
  manifest = File.join(PROJECT_ROOT,
    "ios/Flutter/ephemeral/Packages/FlutterGeneratedPluginSwiftPackage/Package.swift")
  return unless File.exist?(manifest)
  content = File.read(manifest)
  patched = content.sub('.iOS("13.0")', '.iOS("15.5")')
  File.write(manifest, patched) if patched != content
end

# Cloud-signing flags voor xcodebuild: automatic signing werkt dan headless
# en maakt zonodig Apple Distribution certs + App Store profielen aan.
def auth_xcargs
  key_path = File.join(PROJECT_ROOT, "build", "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
  FileUtils.mkdir_p(File.dirname(key_path))
  File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))
  "-allowProvisioningUpdates " \
    "-authenticationKeyPath #{key_path} " \
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
end

# Bepaalt het buildnummer voor één platform en houdt platforms in de pas.
#
# Elk platform heeft op TestFlight z'n eigen build-train, dus hetzelfde nummer
# mag op iOS én tvOS. We hergebruiken daarom het pubspec-nummer zolang dát
# platform het nog niet heeft; alleen als het al op dít platform staat bumpen we
# naar (eigen hoogste + 1). Zo krijgen iOS/tvOS/macOS binnen één release
# hetzelfde nummer — ook als de lanes in aparte fastlane-runs draaien i.p.v. via
# `beta` (geen gedeelde memoization tussen processen).
#
# platform: "ios" | "appletvos" | "osx".
def ensure_build_number(platform)
  ($ensured_build_number ||= {})[platform] ||= begin
    own = begin
      latest_testflight_build_number(api_key: asc_api_key, platform: platform, initial_build_number: 0).to_i
    rescue => e
      UI.important("Geen TestFlight build number voor #{platform}: #{e.message}")
      0
    end
    pubspec = File.join(PROJECT_ROOT, "pubspec.yaml")
    content = File.read(pubspec)
    build_name, local = content[/^version:\s*(\S+)/, 1].split("+")
    local = local.to_i
    # local > own → nummer nog niet op dit platform → hergebruik (blijft gelijk
    # aan een reeds-geüpload ander platform). Anders bumpen we langs dit platform.
    next_number = local > own ? local : own + 1
    if next_number != local
      File.write(pubspec, content.sub(/^version: .*/, "version: #{build_name}+#{next_number}"))
      UI.message("Build number #{local} → #{next_number} (#{platform} hoogste op TestFlight: #{own})")
    end
    next_number
  end
end

def upload_beta(extra = {})
  upload_to_testflight({
    api_key: asc_api_key,
    skip_waiting_for_build_processing: true,
    distribute_external: false, # alleen interne testers
  }.merge(extra))
end

desc "iOS → TestFlight"
lane :ios_beta do
  ensure_build_number("ios")
  flutter_sh("flutter build ios --config-only --release")
  patch_spm_min_ios
  build_app(
    workspace: File.join(PROJECT_ROOT, "ios/Runner.xcworkspace"),
    scheme: "Runner",
    export_method: "app-store",
    output_directory: File.join(PROJECT_ROOT, "build/fastlane/ios"),
    xcargs: auth_xcargs,
  )
  upload_beta
end

desc "tvOS → TestFlight"
lane :tvos_beta do
  ensure_build_number("appletvos")
  flutter_sh("flutter pub get")
  build_app(
    workspace: File.join(PROJECT_ROOT, "tvos/Runner.xcworkspace"),
    scheme: "Runner",
    export_method: "app-store",
    destination: "generic/platform=tvOS",
    output_directory: File.join(PROJECT_ROOT, "build/fastlane/tvos"),
    xcargs: auth_xcargs,
  )
  upload_beta(app_platform: "appletvos")
end

desc "macOS → TestFlight (pkg)"
lane :macos_beta do
  ensure_build_number("osx")
  flutter_sh("flutter build macos --config-only --release")

  out_dir = File.join(PROJECT_ROOT, "build/fastlane/macos")
  archive_path = File.join(out_dir, "Pleya.xcarchive")
  FileUtils.mkdir_p(out_dir)

  # Release signeert ad-hoc ("-") voor de DMG-flow; voor App Store export
  # moet de archive met team + echte identity gesigneerd worden.
  sh("xcodebuild archive " \
     "-workspace #{File.join(PROJECT_ROOT, 'macos/Runner.xcworkspace')} " \
     "-scheme Runner -configuration Release " \
     "-destination 'generic/platform=macOS' " \
     "-archivePath #{archive_path} " \
     "#{auth_xcargs} " \
     "CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=XL9KN38ATX CODE_SIGN_IDENTITY='Apple Development'")

  # Sparkle (DMG-updater, via auto_updater plugin) zit in de bundle. App Store
  # validatie eist dat elk executable daarin gesandboxed is; runtime staat
  # Sparkle toch uit (SUEnableAutomaticChecks=false), dus alleen bijtekenen.
  # De sandbox-entitlements worden NA de export op de pkg toegepast — de export
  # her-signeert Frameworks met Apple Distribution en zou het hier alsnog strippen.
  ent = File.join(out_dir, "sparkle-sandbox.entitlements")
  File.write(ent, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>com.apple.security.app-sandbox</key><true/>
      <key>com.apple.security.inherit</key><true/>
    </dict>
    </plist>
  PLIST

  # De export her-signeert de app en Frameworks, maar slaat de CocoaPods
  # resource-bundles in Contents/Resources over (ITMS-90284). Die moeten met
  # een Apple Distribution cert uit het profiel gesigneerd zijn — de cloud-
  # managed cert kan lokaal niet signen, dus zorg voor een lokale.
  get_certificates(
    api_key: asc_api_key,
    output_path: File.join(PROJECT_ROOT, "build/fastlane/certs"),
  )
  Dir["#{archive_path}/Products/Applications/Pleya.app/Contents/Resources/*.bundle"].each do |bundle|
    sh("codesign --force --sign 'Apple Distribution' #{bundle}")
  end

  export_plist = File.join(out_dir, "ExportOptions.plist")
  File.write(export_plist, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key><string>app-store-connect</string>
      <key>teamID</key><string>XL9KN38ATX</string>
      <key>signingStyle</key><string>automatic</string>
      <key>uploadSymbols</key><false/>
    </dict>
    </plist>
  PLIST
  sh("xcodebuild -exportArchive -archivePath #{archive_path} " \
     "-exportPath #{out_dir} -exportOptionsPlist #{export_plist} #{auth_xcargs}")

  pkg = Dir[File.join(out_dir, "*.pkg")].first
  UI.user_error!("Geen pkg gevonden in #{out_dir}") unless pkg

  # De export strip de sandbox-entitlement weer van de Sparkle-helpers. Fix het
  # NA de export: pkg uitpakken, helpers + framework + app bottom-up her-signeren
  # met Apple Distribution (dezelfde identity die de export gebruikte), en de
  # installer-pkg opnieuw signeren met de Mac Installer Distribution cert.
  expanded = File.join(out_dir, "pkg-expanded")
  FileUtils.rm_rf(expanded)
  sh("pkgutil --expand-full #{pkg} #{expanded}")

  app = Dir["#{expanded}/**/Pleya.app"].first
  UI.user_error!("Geen Pleya.app gevonden in uitgepakte pkg") unless app

  # App-entitlements (incl. app-sandbox + resolved waarden) bewaren voor de app-resign.
  app_ent = File.join(out_dir, "app.entitlements")
  sh("codesign -d --entitlements #{app_ent} --xml #{app}")

  sparkle = "#{app}/Contents/Frameworks/Sparkle.framework"
  [
    "#{sparkle}/Versions/B/Autoupdate",
    "#{sparkle}/Versions/B/Updater.app",
    "#{sparkle}/Versions/B/XPCServices/Downloader.xpc",
    "#{sparkle}/Versions/B/XPCServices/Installer.xpc",
  ].each do |nested|
    sh("codesign --force --entitlements #{ent} --sign 'Apple Distribution' #{nested}")
  end
  sh("codesign --force --sign 'Apple Distribution' #{sparkle}")
  sh("codesign --force --entitlements #{app_ent} --sign 'Apple Distribution' #{app}")

  # Sanity: app-sandbox moet nu op de helper staan, app blijft Apple Distribution.
  helper_ent = `codesign -d --entitlements - #{sparkle}/Versions/B/Autoupdate 2>&1`
  unless helper_ent.include?("com.apple.security.app-sandbox")
    UI.user_error!("Sparkle-helper mist app-sandbox entitlement na resign")
  end
  sh("codesign -dv --verbose=4 #{app}")

  # Component-pkg herbouwen en installer opnieuw signeren met de Mac Installer cert.
  installer_identity = `security find-identity -v -p basic`.lines
    .map { |l| l[/"(3rd Party Mac Developer Installer:[^"]+)"/, 1] }
    .compact.first
  UI.user_error!("Geen Mac Installer Distribution cert in keychain") unless installer_identity

  patched_pkg = File.join(out_dir, "Pleya-patched.pkg")
  signed_pkg = File.join(out_dir, "Pleya-signed.pkg")
  FileUtils.rm_f([patched_pkg, signed_pkg])
  sh("pkgutil --flatten #{expanded} #{patched_pkg}")
  sh("productsign --sign '#{installer_identity}' #{patched_pkg} #{signed_pkg}")
  sh("pkgutil --check-signature #{signed_pkg}")

  upload_beta(app_platform: "osx", pkg: signed_pkg)
end

desc "Alle platforms → TestFlight; gaat door als één platform faalt"
lane :beta do
  failures = []
  begin
    ios_beta
  rescue => e
    UI.error("ios faalde: #{e.message}")
    failures << "ios"
  end
  begin
    tvos_beta
  rescue => e
    UI.error("tvos faalde: #{e.message}")
    failures << "tvos"
  end
  begin
    macos_beta
  rescue => e
    UI.error("macos faalde: #{e.message}")
    failures << "macos"
  end
  UI.user_error!("TestFlight upload mislukt voor: #{failures.join(', ')}") unless failures.empty?
end
