# TestFlight-uploads voor iOS, tvOS en macOS (interne testers, geen Beta App Review).
# Credentials via .env in de project root (fastlane laadt die automatisch):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (base64 van de .p8)
# Aanroepen: `fastlane beta` (alles) of `fastlane ios_beta` / `tvos_beta` / `macos_beta`.

opt_out_usage

PROJECT_ROOT = File.expand_path("..", __dir__)
BUNDLE_ID = "nl.michelknoop.pleya"

# Lane-platform → App Store Connect-platform.
ASC_PLATFORM = {
  "ios" => "IOS",
  "appletvos" => "TV_OS",
  "osx" => "MAC_OS",
}.freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true,
  )
end

# Flutter shelt uit naar `pod`; fastlane's eigen GEM_HOME/GEM_PATH/RUBYOPT
# breken CocoaPods (Gem::MissingSpecError) — strip die voor flutter-calls.
def flutter_sh(cmd)
  sh("cd #{PROJECT_ROOT} && env -u GEM_HOME -u GEM_PATH -u RUBYOPT -u RUBYLIB -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH #{cmd}")
end

# Flutter genereert de umbrella-SPM-package (ios/Flutter/ephemeral/, gitignored)
# op iOS 13.0, maar background_downloader eist 14.0. Xcode resolvet Swift-packages
# vóór Flutter's eigen updateMinimumDeployment draait, dus forceer het manifest
# hier op de app-deploymenttarget — anders faalt build_app op
# "requires minimum platform version 14.0 ... but this target supports 13.0".
def patch_spm_min_ios
  manifest = File.join(PROJECT_ROOT,
    "ios/Flutter/ephemeral/Packages/FlutterGeneratedPluginSwiftPackage/Package.swift")
  return unless File.exist?(manifest)
  content = File.read(manifest)
  patched = content.sub('.iOS("13.0")', '.iOS("15.5")')
  File.write(manifest, patched) if patched != content
end

# Cloud-signing flags voor xcodebuild: automatic signing werkt dan headless
# en maakt zonodig Apple Distribution certs + App Store profielen aan.
def auth_xcargs
  key_path = File.join(PROJECT_ROOT, "build", "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
  FileUtils.mkdir_p(File.dirname(key_path))
  File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))
  "-allowProvisioningUpdates " \
    "-authenticationKeyPath #{key_path} " \
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
end

# Bepaalt het buildnummer voor één platform en houdt platforms in de pas.
#
# Elk platform heeft op TestFlight z'n eigen build-train, dus hetzelfde nummer
# mag op iOS én tvOS. We hergebruiken daarom het pubspec-nummer zolang dát
# platform het nog niet heeft; alleen als het al op dít platform staat bumpen we
# naar (eigen hoogste + 1). Zo krijgen iOS/tvOS/macOS binnen één release
# hetzelfde nummer — ook als de lanes in aparte fastlane-runs draaien i.p.v. via
# `beta` (geen gedeelde memoization tussen processen).
#
# platform: "ios" | "appletvos" | "osx".
def ensure_build_number(platform)
  ($ensured_build_number ||= {})[platform] ||= begin
    own = begin
      latest_testflight_build_number(api_key: asc_api_key, platform: platform, initial_build_number: 0).to_i
    rescue => e
      UI.important("Geen TestFlight build number voor #{platform}: #{e.message}")
      0
    end
    pubspec = File.join(PROJECT_ROOT, "pubspec.yaml")
    content = File.read(pubspec)
    build_name, local = content[/^version:\s*(\S+)/, 1].split("+")
    local = local.to_i
    # local > own → nummer nog niet op dit platform → hergebruik (blijft gelijk
    # aan een reeds-geüpload ander platform). Anders bumpen we langs dit platform.
    next_number = local > own ? local : own + 1
    if next_number != local
      File.write(pubspec, content.sub(/^version: .*/, "version: #{build_name}+#{next_number}"))
      UI.message("Build number #{local} → #{next_number} (#{platform} hoogste op TestFlight: #{own})")
    end
    next_number
  end
end

def upload_beta(extra = {})
  upload_to_testflight({
    api_key: asc_api_key,
    skip_waiting_for_build_processing: true,
    distribute_external: false, # alleen interne testers
  }.merge(extra))
end

# External distributie: wacht op processing en zet de build klaar voor de
# external groep (triggert Beta App Review bij de eerste build van een versie).
# Groepsnaam via EXTERNAL_GROUP (default "External Testers") — groep moet al
# bestaan in App Store Connect onder TestFlight → External Testing.
EXTERNAL_GROUP = ENV.fetch("EXTERNAL_GROUP", "External Testers")

# Het buildnummer zoals het in pubspec.yaml staat. De external-lane geeft geen
# ipa mee (fastlane pakt de laatst geüploade build), dus dit is de enige plek
# waar het nummer nog vandaan kan komen.
def local_build_number
  File.read(File.join(PROJECT_ROOT, "pubspec.yaml"))[/^version:\s*\S+\+(\d+)/, 1]
end

# Zoals release_notes_for, maar stopt de lane als ze ontbreken. Voor external
# distributie is dat terecht: die tekst gaat langs Beta App Review en naar
# mensen buiten je eigen toestellen, dus daar is "onbekend" geen uitkomst.
def required_notes_for(build_number)
  notes = release_notes_for(build_number)
  UI.user_error!("Geen releasenotes voor build #{build_number} in docs/RELEASES.md; draai eerst /update-docs") unless notes
  testflight_notes(notes)
end

def upload_external(extra = {})
  upload_to_testflight({
    api_key: asc_api_key,
    distribute_external: true,
    groups: [EXTERNAL_GROUP],
    # Uit docs/RELEASES.md, net als de interne builds. Hier stond jarenlang
    # "Bugfixes en verbeteringen", precies de tekst waar de publieke
    # releasenotes voor bedacht zijn. Externe distributie gaat langs Beta App
    # Review, dus dit is ook de tekst die een reviewer leest.
    changelog: ENV["TESTFLIGHT_CHANGELOG"] || required_notes_for(local_build_number),
    # external distributie kan pas ná processing → hier wél wachten
    skip_waiting_for_build_processing: false,
  }.merge(extra))
end

# App Store Connect koppelt een geüploade build niet vanzelf aan het
# versierecord: die blijft in TestFlight staan tot iemand hem selecteert. Dat
# ging fout bij de 2.1(a)-hertest — de versies hingen nog aan de afgewezen build
# 156 terwijl 220 al een maand klaarstond. Sindsdien doen de lanes het zelf.
def spaceship_app
  $spaceship_app ||= begin
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")),
    )
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("App #{BUNDLE_ID} niet gevonden in App Store Connect") unless app
    app
  end
end

# Wacht tot de zojuist geüploade build door processing is. Uploaden gebeurt met
# skip_waiting_for_build_processing, dus vlak na de upload bestaat de build in de
# API nog niet of staat hij op PROCESSING; koppelen kan pas bij VALID.
def wait_for_build(platform, build_number, timeout)
  asc_platform = ASC_PLATFORM.fetch(platform)
  deadline = Time.now + timeout
  reported = nil
  loop do
    build = spaceship_app.get_builds(
      filter: { "preReleaseVersion.platform" => asc_platform, version: build_number.to_s },
      limit: 1,
    ).first
    state = build&.processing_state
    return build if state == "VALID"
    UI.user_error!("Build #{build_number} (#{platform}) is #{state}") if %w[FAILED INVALID].include?(state)
    if Time.now > deadline
      UI.important("Build #{build_number} (#{platform}) is na #{timeout}s nog #{state || 'niet zichtbaar'}")
      return nil
    end
    if state != reported
      reported = state
      UI.message("Wachten op processing van build #{build_number} (#{platform}): #{state || 'nog niet zichtbaar'}")
    end
    sleep(30)
  end
end

# Leest de publieke releasenotes van één build uit docs/RELEASES.md.
#
# Dat bestand is de enige bron: wat een tester in TestFlight leest hoort exact
# te zijn wat er op pleya.app/releases staat. Een aparte tekst hier zou binnen
# twee builds uit elkaar lopen, en dan weet niemand meer welke van de twee de
# waarheid is.
#
# De sectiekop ziet er zo uit: "## 2.8.0 · build 227 · 18 August 2026". Alles
# tot de volgende "## " hoort erbij. Nil als de notities voor deze build nog
# niet geschreven zijn; dat is de normale toestand vlak na een upload, want
# /update-docs draait daarna.
def release_notes_for(build_number)
  path = File.join(PROJECT_ROOT, "docs/RELEASES.md")
  return nil unless File.exist?(path)
  match = File.read(path).match(/^\#\# [^\n]*\bbuild #{build_number}\b[^\n]*\n(.*?)(?=^\#\# |\z)/m)
  return nil unless match
  body = match[1].gsub(/<!--.*?-->/m, "")
  body.strip.empty? ? nil : body.strip
end

# Markdown naar de platte tekst die het "What to Test"-veld toont. TestFlight
# rendert geen opmaak, dus sterretjes en hekjes worden daar letterlijk zichtbaar.
def testflight_notes(markdown)
  markdown
    .gsub(/^\#+\s*/, "")           # "### New" wordt "New"
    .gsub(/\*\*(.+?)\*\*/, '\\1')  # vetdruk eruit
    .gsub(/^- /, "\u2022 ")         # streepjes naar bolletjes, leest rustiger
    .gsub(/\n{3,}/, "\n\n")
    .strip
end

# Zet de releasenotes als "What to Test" op een build die al door processing is.
#
# Kan niet bij het uploaden: de lanes gebruiken skip_waiting_for_build_processing
# zodat platform twee niet staat te wachten op Apple's processing van platform
# één, en fastlane weigert dan een changelog te zetten. Hier zijn we toch al
# voorbij dat punt, want koppelen vereist een VALID build.
def set_build_notes(build, notes)
  # Zelf afkappen in plaats van Pilot::BuildManager.sanitize_changelog: die is
  # alleen geladen als de lane ook uploadt, en `fastlane notes` doet dat niet.
  # 4000 is de grens die App Store Connect op dit veld hanteert.
  text = testflight_notes(notes)
  if text.length > 4000
    UI.important("Releasenotes zijn #{text.length} tekens; TestFlight neemt er 4000")
    text = "#{text[0, 3997]}..."
  end
  localizations = build.get_beta_build_localizations
  if localizations.empty?
    Spaceship::ConnectAPI.post_beta_build_localizations(
      build_id: build.id, attributes: { whatsNew: text, locale: "en-US" }
    )
  else
    localizations.each do |loc|
      Spaceship::ConnectAPI.patch_beta_build_localizations(
        localization_id: loc.id, attributes: { whatsNew: text }
      )
    end
  end
  verify_build_notes(build, text)
end

# Leest terug wat er nu op de build staat en vergelijkt het met wat we stuurden.
#
# Een geslaagde POST of PATCH is geen bewijs dat een tester de tekst ziet: het
# veld heeft een lengtegrens, Apple normaliseert regeleindes, en een build met
# meerdere locales kan er één missen. Dit is dus geen dubbelop maar de enige
# controle die over het uiteindelijke veld gaat.
#
# Regeleindes worden aan beide kanten genormaliseerd voordat er vergeleken
# wordt; alleen daarop verschillen zou een valse afwijking zijn.
def verify_build_notes(build, expected)
  want = expected.gsub("\r\n", "\n")
  found = build.get_beta_build_localizations
  UI.user_error!("Geen beta build localization op deze build na het schrijven") if found.empty?
  mismatched = found.reject { |loc| loc.whats_new.to_s.gsub("\r\n", "\n") == want }
  unless mismatched.empty?
    locales = mismatched.map { |loc| "#{loc.locale} (#{loc.whats_new.to_s.length} tekens)" }
    UI.user_error!("What to Test wijkt af van wat er gestuurd is: #{locales.join(', ')}")
  end
  UI.message("Teruggelezen: #{found.length} locale(s), #{want.length} tekens, gelijk aan de bron")
  true
end

# Koppelt build_number aan de bewerkbare App Store-versie van dit platform.
# Geeft true bij succes, false als er niets te koppelen viel.
def attach_build_to_version(platform, build_number, timeout: ENV.fetch("ASC_ATTACH_TIMEOUT", "1800").to_i)
  asc_platform = ASC_PLATFORM.fetch(platform)
  version = spaceship_app.get_edit_app_store_version(platform: asc_platform)
  # Geen bewerkbare versie = in review of live; dan mag er niets gewijzigd worden.
  unless version
    UI.important("#{platform}: geen bewerkbare App Store-versie, build #{build_number} niet gekoppeld")
    return false
  end

  build = wait_for_build(platform, build_number, timeout)
  return false unless build

  current = version.get_build
  if current&.id == build.id
    UI.message("#{platform} #{version.version_string}: build #{build_number} was al gekoppeld")
    return true
  end

  version.select_build(build_id: build.id)
  UI.success("#{platform} #{version.version_string}: build #{current&.version || 'geen'} → #{build_number} gekoppeld")
  apply_release_notes(platform, build_number, build)
  true
end

# Zet de notities als ze er zijn, en zeg het als ze er niet zijn.
#
# Vlak na een upload bestaan ze meestal nog niet, want /update-docs schrijft ze
# daarna. Dat is geen fout en mag een geslaagde release niet omver halen, maar
# stilzwijgend overslaan zou betekenen dat builds jarenlang zonder uitleg in
# TestFlight blijven staan. Vandaar de melding met het commando dat het herstelt.
def apply_release_notes(platform, build_number, build)
  notes = release_notes_for(build_number)
  if notes.nil?
    UI.important("#{platform}: geen releasenotes voor build #{build_number} in docs/RELEASES.md")
    UI.important("Na /update-docs bijwerken met: fastlane notes build:#{build_number}")
    return false
  end
  set_build_notes(build, notes)
  UI.success("#{platform}: releasenotes op build #{build_number} gezet")
  true
rescue => e
  UI.important("#{platform}: releasenotes zetten faalde: #{e.message}")
  false
end

# Aanroep vanuit de upload-lanes. Nooit fataal: de build staat dan al op
# TestFlight en `fastlane attach_builds` haalt het koppelen later in.
def attach_after_upload(platform, build_number)
  return ($pending_attach ||= {})[platform] = build_number if $defer_attach
  attach_build_to_version(platform, build_number)
rescue => e
  UI.important("Koppelen van build #{build_number} (#{platform}) faalde: #{e.message}")
  UI.important("Later herstellen met: fastlane attach_builds platform:#{platform} build:#{build_number}")
end

desc "iOS → TestFlight"
lane :ios_beta do
  build_number = ensure_build_number("ios")
  flutter_sh("flutter build ios --config-only --release")
  patch_spm_min_ios
  build_app(
    workspace: File.join(PROJECT_ROOT, "ios/Runner.xcworkspace"),
    scheme: "Runner",
    export_method: "app-store",
    output_directory: File.join(PROJECT_ROOT, "build/fastlane/ios"),
    xcargs: auth_xcargs,
  )
  upload_beta
  attach_after_upload("ios", build_number)
end

desc "tvOS → TestFlight"
lane :tvos_beta do
  build_number = ensure_build_number("appletvos")
  flutter_sh("flutter pub get")
  # tvOS bouwt op een eigen engine-fork (edde746/flutter-tvos) uit
  # ~/.cache/flutter-tvos-engine, plus een projectkopie in tvos/Flutter/ephemeral/.
  # Deze lane genereerde als enige zijn eigen config niet — ios_beta en
  # macos_beta draaien `flutter build --config-only` — en leunde dus op
  # artefacten van een eerdere build. Een verse clone, een `flutter clean` of
  # een leeggeruimde cache brak de archive op "Unable to find module
  # dependency: 'Flutter'", een fout die nergens naar de echte oorzaak wijst.
  # fetch_engine.sh is idempotent (slaat de download over als de cache al klopt)
  # en herschrijft Generated.xcconfig — daarom ná ensure_build_number, want het
  # neemt het buildnummer uit pubspec.yaml over.
  sh("cd #{PROJECT_ROOT} && tvos/scripts/fetch_engine.sh")
  build_app(
    workspace: File.join(PROJECT_ROOT, "tvos/Runner.xcworkspace"),
    scheme: "Runner",
    export_method: "app-store",
    destination: "generic/platform=tvOS",
    output_directory: File.join(PROJECT_ROOT, "build/fastlane/tvos"),
    xcargs: auth_xcargs,
  )
  upload_beta(app_platform: "appletvos")
  attach_after_upload("appletvos", build_number)
end

desc "macOS → TestFlight (pkg)"
lane :macos_beta do
  build_number = ensure_build_number("osx")
  flutter_sh("flutter build macos --config-only --release")
  # Buildnummer/-naam expliciet aan xcodebuild meegeven: DerivedData herprocesst
  # de Info.plist niet altijd als alleen de ephemeral xcconfig wijzigt → stale
  # CFBundleVersion in de archive (158-upload-rejectie terwijl de xcconfig al
  # 160 zei). Command-line xcodebuild-args overrulen elke cache.
  build_name = File.read(File.join(PROJECT_ROOT, "pubspec.yaml"))[/^version:\s*(\S+)/, 1].split("+").first

  out_dir = File.join(PROJECT_ROOT, "build/fastlane/macos")
  archive_path = File.join(out_dir, "Pleya.xcarchive")
  FileUtils.mkdir_p(out_dir)

  # Release signeert ad-hoc ("-") voor de DMG-flow; voor App Store export
  # moet de archive met team + echte identity gesigneerd worden.
  sh("xcodebuild archive " \
     "-workspace #{File.join(PROJECT_ROOT, 'macos/Runner.xcworkspace')} " \
     "-scheme Runner -configuration Release " \
     "-destination 'generic/platform=macOS' " \
     "-archivePath #{archive_path} " \
     "#{auth_xcargs} " \
     "CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=XL9KN38ATX CODE_SIGN_IDENTITY='Apple Development' " \
     "FLUTTER_BUILD_NAME=#{build_name} FLUTTER_BUILD_NUMBER=#{build_number}")

  # Sparkle (DMG-updater, via auto_updater plugin) zit in de bundle. App Store
  # validatie eist dat elk executable daarin gesandboxed is; runtime staat
  # Sparkle toch uit (SUEnableAutomaticChecks=false), dus alleen bijtekenen.
  # De sandbox-entitlements worden NA de export op de pkg toegepast — de export
  # her-signeert Frameworks met Apple Distribution en zou het hier alsnog strippen.
  ent = File.join(out_dir, "sparkle-sandbox.entitlements")
  File.write(ent, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>com.apple.security.app-sandbox</key><true/>
      <key>com.apple.security.inherit</key><true/>
    </dict>
    </plist>
  PLIST

  # De export her-signeert de app en Frameworks, maar slaat de CocoaPods
  # resource-bundles in Contents/Resources over (ITMS-90284). Die moeten met
  # een Apple Distribution cert uit het profiel gesigneerd zijn — de cloud-
  # managed cert kan lokaal niet signen, dus zorg voor een lokale.
  get_certificates(
    api_key: asc_api_key,
    output_path: File.join(PROJECT_ROOT, "build/fastlane/certs"),
  )
  Dir["#{archive_path}/Products/Applications/Pleya.app/Contents/Resources/*.bundle"].each do |bundle|
    sh("codesign --force --sign 'Apple Distribution' #{bundle}")
  end

  export_plist = File.join(out_dir, "ExportOptions.plist")
  File.write(export_plist, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key><string>app-store-connect</string>
      <key>teamID</key><string>XL9KN38ATX</string>
      <key>signingStyle</key><string>automatic</string>
      <key>uploadSymbols</key><false/>
    </dict>
    </plist>
  PLIST
  # Oude pkg's weg vóór de export: de glob hieronder pakte anders alfabetisch
  # de stale Pleya-signed.pkg van een vorige run i.p.v. de verse export
  # (→ tweemaal een 158-upload-rejectie terwijl de archive al 160 was).
  FileUtils.rm_f(Dir[File.join(out_dir, "*.pkg")])
  sh("xcodebuild -exportArchive -archivePath #{archive_path} " \
     "-exportPath #{out_dir} -exportOptionsPlist #{export_plist} #{auth_xcargs}")

  pkg = Dir[File.join(out_dir, "*.pkg")].first
  UI.user_error!("Geen pkg gevonden in #{out_dir}") unless pkg

  # De export strip de sandbox-entitlement weer van de Sparkle-helpers. Fix het
  # NA de export: pkg uitpakken, helpers + framework + app bottom-up her-signeren
  # met Apple Distribution (dezelfde identity die de export gebruikte), en de
  # installer-pkg herbouwen met `productbuild --component`.
  #
  # Belangrijk: NIET `pkgutil --expand-full` — die dereferenced de framework-
  # symlinks (Versions/Current, Resources) tot echte directories, waardoor de
  # her-geflatte pkg een Bom-vs-Payload-mismatch krijgt → ITMS-90229 op elk
  # framework. extract_pkg_app.sh pakt de Payload symlink-behoudend uit en
  # `productbuild --component` behoudt die layout in de nieuwe pkg.
  expanded = File.join(out_dir, "pkg-expanded")
  app = sh("#{File.join(PROJECT_ROOT, 'scripts/extract_pkg_app.sh')} #{pkg} #{expanded}").strip
  UI.user_error!("Geen Pleya.app gevonden in uitgepakte pkg") if app.empty? || !File.directory?(app)

  # App-entitlements (incl. app-sandbox + resolved waarden) bewaren voor de app-resign.
  app_ent = File.join(out_dir, "app.entitlements")
  sh("codesign -d --entitlements #{app_ent} --xml #{app}")

  sparkle = "#{app}/Contents/Frameworks/Sparkle.framework"
  [
    "#{sparkle}/Versions/B/Autoupdate",
    "#{sparkle}/Versions/B/Updater.app",
    "#{sparkle}/Versions/B/XPCServices/Downloader.xpc",
    "#{sparkle}/Versions/B/XPCServices/Installer.xpc",
  ].each do |nested|
    sh("codesign --force --entitlements #{ent} --sign 'Apple Distribution' #{nested}")
  end
  sh("codesign --force --sign 'Apple Distribution' #{sparkle}")
  sh("codesign --force --entitlements #{app_ent} --sign 'Apple Distribution' #{app}")

  # Sanity: app-sandbox moet nu op de helper staan, app blijft Apple Distribution.
  helper_ent = `codesign -d --entitlements - #{sparkle}/Versions/B/Autoupdate 2>&1`
  unless helper_ent.include?("com.apple.security.app-sandbox")
    UI.user_error!("Sparkle-helper mist app-sandbox entitlement na resign")
  end
  sh("codesign -dv --verbose=4 #{app}")

  # Installer-pkg herbouwen met `productbuild --component` (behoudt de framework-
  # symlink-layout) en direct signeren met de Mac Installer Distribution cert.
  # De Sparkle-helpers zijn hierboven al gesigneerd, dus de sandbox-entitlement
  # blijft staan.
  installer_identity = `security find-identity -v -p basic`.lines
    .map { |l| l[/"(3rd Party Mac Developer Installer:[^"]+)"/, 1] }
    .compact.first
  UI.user_error!("Geen Mac Installer Distribution cert in keychain") unless installer_identity

  signed_pkg = File.join(out_dir, "Pleya-signed.pkg")
  FileUtils.rm_f(signed_pkg)
  sh("productbuild --component #{app} /Applications " \
     "--sign '#{installer_identity}' #{signed_pkg}")
  sh("pkgutil --check-signature #{signed_pkg}")

  upload_beta(app_platform: "osx", pkg: signed_pkg)
  attach_after_upload("osx", build_number)
end

desc "Laatste build(s) naar external testgroep (Beta App Review bij eerste build van een versie)"
lane :external do |options|
  # platform: "ios" | "appletvos" | "osx"; zonder optie alle drie.
  platforms = options[:platform] ? [options[:platform]] : %w[ios appletvos osx]
  failures = []
  platforms.each do |platform|
    upload_external(
      app_platform: platform,
      # geen ipa/pkg meegeven → fastlane pakt de laatste geüploade build
      distribute_only: true,
    )
  rescue => e
    UI.error("external distributie #{platform} faalde: #{e.message}")
    failures << platform
  end
  UI.user_error!("External distributie mislukt voor: #{failures.join(', ')}") unless failures.empty?
end

desc "E-mailadressen toevoegen aan de external testgroep: fastlane add_testers emails:a@x.nl,b@y.nl"
lane :add_testers do |options|
  emails = (options[:emails] || "").split(",").map(&:strip).reject(&:empty?)
  UI.user_error!("Geef emails op: fastlane add_testers emails:a@x.nl,b@y.nl") if emails.empty?
  # `pilot` in een Fastfile is een alias voor upload_to_testflight en kent geen
  # tester-commando's — dus via Spaceship::ConnectAPI.
  group = spaceship_app.get_beta_groups(filter: { name: EXTERNAL_GROUP }).first
  UI.user_error!("Testgroep '#{EXTERNAL_GROUP}' bestaat niet — maak hem eerst aan in App Store Connect → TestFlight → External Testing") unless group
  emails.each do |email|
    group.post_bulk_beta_tester_assignments(beta_testers: [{ email: email }])
    UI.success("#{email} toegevoegd aan '#{EXTERNAL_GROUP}'")
  rescue => e
    UI.error("#{email} toevoegen faalde: #{e.message}")
  end
end

desc "Laatste build aan het App Store-versierecord koppelen: fastlane attach_builds [platform:ios] [build:220]"
lane :attach_builds do |options|
  platforms = options[:platform] ? [options[:platform]] : ASC_PLATFORM.keys
  timeout = (options[:timeout] || ENV.fetch("ASC_ATTACH_TIMEOUT", "1800")).to_i
  failures = []
  platforms.each do |platform|
    # Zonder build-optie: de hoogste build die dit platform op TestFlight heeft.
    number = options[:build] || latest_testflight_build_number(
      api_key: asc_api_key, platform: platform, initial_build_number: 0
    )
    attach_build_to_version(platform, number, timeout: timeout) || failures << platform
  rescue => e
    UI.error("#{platform}: #{e.message}")
    failures << platform
  end
  UI.user_error!("Koppelen mislukt of overgeslagen voor: #{failures.join(', ')}") unless failures.empty?
end

desc "Releasenotes uit docs/RELEASES.md op een TestFlight-build zetten: fastlane notes build:227"
lane :notes do |options|
  build_number = options[:build] || local_build_number
  UI.user_error!("Geen buildnummer") unless build_number
  notes = required_notes_for(build_number)
  UI.message("Notities voor build #{build_number}, #{notes.length} tekens:")
  notes.lines.first(4).each { |l| UI.message("  #{l.chomp}") }

  platforms = options[:platform] ? [options[:platform]] : ASC_PLATFORM.keys
  timeout = (options[:timeout] || ENV.fetch("ASC_ATTACH_TIMEOUT", "1800")).to_i
  failures = []
  platforms.each do |platform|
    build = wait_for_build(platform, build_number, timeout)
    if build.nil?
      UI.important("#{platform}: build #{build_number} niet gevonden of nog niet VALID")
      failures << platform
      next
    end
    set_build_notes(build, release_notes_for(build_number))
    UI.success("#{platform}: releasenotes op build #{build_number} gezet")
  rescue => e
    UI.error("#{platform}: #{e.message}")
    failures << platform
  end
  UI.user_error!("Notities zetten mislukt voor: #{failures.join(', ')}") unless failures.empty?
end

desc "Alle platforms → TestFlight; gaat door als één platform faalt"
lane :beta do
  failures = []
  # Uploads eerst, koppelen daarna: anders staat iedere lane te wachten op
  # Apple's processing terwijl het volgende platform nog gebouwd moet worden.
  $defer_attach = true
  $pending_attach = {}
  begin
    ios_beta
  rescue => e
    UI.error("ios faalde: #{e.message}")
    failures << "ios"
  end
  begin
    tvos_beta
  rescue => e
    UI.error("tvos faalde: #{e.message}")
    failures << "tvos"
  end
  begin
    macos_beta
  rescue => e
    UI.error("macos faalde: #{e.message}")
    failures << "macos"
  end
  $defer_attach = false
  $pending_attach.each do |platform, number|
    attach_build_to_version(platform, number)
  rescue => e
    UI.important("Koppelen van build #{number} (#{platform}) faalde: #{e.message}")
    UI.important("Later herstellen met: fastlane attach_builds platform:#{platform} build:#{number}")
  end
  UI.user_error!("TestFlight upload mislukt voor: #{failures.join(', ')}") unless failures.empty?
end
